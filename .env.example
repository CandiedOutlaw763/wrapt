# Qloo hackathon API (https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Product search — SerpApi first, Canopy as fallback. Either is optional;
# with neither, gifts link to an Amazon search page instead of a listing.
SERPAPI_KEY=
CANOPY_API_KEY=

# Optional: Upstash Redis for a persistent cache across serverless instances
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
