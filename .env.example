# Qloo hackathon API (https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Groq (https://console.groq.com/keys). Key 1 runs the taste strategist, key 2 the
# personal shopper; each falls back to the other when rate limited. One key works too.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b

# Amazon listings via SerpApi (https://serpapi.com). Key 2 takes over when key 1
# runs out of searches. With neither, gifts link to an Amazon search page.
SERPAPI_KEY=
SERPAPI_KEY_2=

# Optional: Upstash Redis for a persistent cache across serverless instances
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Firebase (optional): sign-in with Google, email or guest, and personas + runs saved
# to Firestore. Without these, sign-in is hidden and data stays in the browser.
# Firebase console → Project settings → Your apps → Web app → SDK config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
